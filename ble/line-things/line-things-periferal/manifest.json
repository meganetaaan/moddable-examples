{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_piu.json",
    "$(MODDABLE)/modules/io/ble/server/manifest.json"
  ],
  "modules": {
    "mac-address": "./mac-address",
    "*": [
      "./line-things-server",
      "./line-things-application",
      "./main"
    ]
  },
  "resources": {
    "*-alpha": "$(MODDABLE)/examples/assets/fonts/OpenSans-Semibold-16"
  },
  "platforms": {
    "esp32/m5stack": {},
    "esp32/m5stack_fire": {},
    "...": {
      "error": "The LINE Things example requires M5Stack and ESP32 BLE"
    }
  }
}
