{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_piu.json",
    "$(MODULES)/pins/i2s/manifest.json",
    "$(MODULES)/drivers/neopixel/manifest.json",
    "$(MODULES)/io/wifi/manifest.json"
  ],
  "modules": {
    "piu/Sound": "$(MODULES)/piu/MC/piuSound",
    "*": "./main"
  },
  "resources": {
    "*": [
      "./assets/images/*",
      "./assets/sounds/*"
    ]
  },
  "defines": {
    "neopixel": {
      "length": 60,
      "pin": 21,
      "order": "#GRB"
    }
  },
  "platforms": {
    "esp32/m5stack": {},
    "esp32/m5stack_fire": {},
    "...": {
      "error": "Colorful Bongo requires an M5Stack and a 60-pixel strip on pin 21"
    }
  }
}
