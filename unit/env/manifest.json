{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_piu.json",
    "$(MODDABLE)/modules/io/manifest.json"
  ],
  "modules": {
    "*": "./*"
  },
  "platforms": {
    "esp32/m5stack": {
      "config": {
        "unit_i2c": "default"
      }
    },
    "esp32/m5stack_fire": {
      "config": {
        "unit_i2c": "default"
      }
    },
    "esp32/m5stick_c": {
      "config": {
        "unit_i2c": "hat"
      }
    }
  },
  "resources": {
    "*-alpha": [
      "$(MODDABLE)/examples/assets/fonts/OpenSans-Semibold-16"
    ]
  }
}
