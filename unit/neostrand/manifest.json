{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/modules/io/digital/manifest.json",
    "$(MODULES)/drivers/neopixel/manifest.json"
  ],
  "build": {
    "IO": "$(MODDABLE)/modules/io"
  },
  "defines": {
    "ECMA419": {
      "enabled": 1
    }
  },
  "modules": {
    "*": "./main",
    "neostrand": "$(MODULES)/drivers/neostrand/neostrand",
    "piu/Timeline": "$(MODULES)/piu/All/piuTimeline"
  },
  "preload": [
    "neopixel",
    "neostrand",
    "piu/Timeline"
  ],
  "config": {
    "strand": {
      "length": 29,
      "pin": 32,
      "order": "RGB",
      "brightness": 128
    },
    "button": {
      "pin": 37
    }
  },
  "platforms": {
    "esp32/m5stack": {
      "config": {
        "strand": {
          "pin": 21
        },
        "button": {
          "pin": 39
        }
      }
    },
    "esp32/m5stack_fire": {
      "config": {
        "strand": {
          "pin": 21
        },
        "button": {
          "pin": 39
        }
      }
    },
    "esp32/m5stick_c": {},
    "...": {
      "error": "NeoStrand requires an M5Stack or M5StickC"
    }
  }
}
