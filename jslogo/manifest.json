{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_piu.json"
  ],
  "modules": {
    "*": "./main"
  },
  "resources": {
    "*-alpha": [
      "./assets/js-logo"
    ],
    "*-mask": [
      "./assets/moddable-logo"
    ]
  },
  "platforms": {
    "esp32/m5stack": {},
    "esp32/m5stack_fire": {},
    "...": {
      "error": "JS Logo requires an M5Stack button and display"
    }
  }
}
