{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_piu.json"
  ],
  "modules": {
    "*": [
      "./main",
      "./pomodoro"
    ]
  },
  "preload": [
    "pomodoro"
  ],
  "resources": {
    "*-alpha": "$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-52",
    "*": "./assets/images/*"
  },
  "platforms": {
    "esp32/m5stack": {},
    "esp32/m5stack_fire": {},
    "...": {
      "error": "Pomodoro requires an M5Stack display and buttons"
    }
  }
}
