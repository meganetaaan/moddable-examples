{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/examples/manifest_piu.json",
		"$(MODDABLE)/modules/drivers/destm32s/manifest.json"
	],
	"modules": {
		"*": "./main"
	},
	"resources":{
		"*-mask": [
			"./fonts/Houstiny",
			"./images/dog"
		]
	},
	"config": {
		"screen": "destm32s",
		"touch": "",
		"format": "Gray256",
		"rotation": 270
	},
	"defines": {
		"spi": {
			"mosi_pin": 14,
			"sck_pin": 13
		},
		"destm32s": {
			"hz": 4000000,
			"width": 400,
			"height": 300,
			"cs_pin": 15,
			"dc_pin": 27,
			"rst_pin": 26,
			"busy_pin": 25,
			"spi_port": "SPI3_HOST"
		}
	},
	"platforms": {
		"esp32": {},
		"...": {
			"error": "This 400x300 e-paper wiring is supported on ESP32"
		}
	}
}
