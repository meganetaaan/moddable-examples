{
  "include": [
    "$(MODULES)/drivers/neopixel/manifest.json",
    "$(MODULES)/io/display/manifest.json"
  ],
  "config": {
    "screen": "neomatrix-render",
    "touch": "",
    "neomatrix": {
      "pin": 27,
      "width": 5,
      "height": 5,
      "brightness": 0.125,
      "layout": "columns-reversed",
      "order": "GRB"
    }
  },
  "modules": {
    "neomatrix-render": "../shared/neomatrix-display",
    "neomatrix": "../shared/neomatrix",
    "neomatrix-utils": "../shared/neomatrix-utils",
    "commodetto/Bitmap": "$(COMMODETTO)/commodettoBitmap"
  },
  "preload": [
    "commodetto/*",
    "neopixel",
    "neomatrix",
    "neomatrix-render",
    "neomatrix-utils"
  ],
  "platforms": {
    "esp32": {},
    "...": {
      "error": "unsupported platform"
    }
  }
}
